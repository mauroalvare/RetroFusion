*.zip
*.rar
*.7z

# --- Firmware: solo lo que se puede redistribuir
emu/roms/*
!emu/roms/48.rom
!emu/roms/c64/
emu/roms/samples/

# --- Pruebas grandes o de licencia dudosa (se bajan aparte)
emu/testdata/6502/
emu/testdata/8080/CPUTEST.COM

# --- Temporales
*.tmp
